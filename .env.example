# Non-secret example environment for the username-claim flow.
# Copy to .env.local for development. Never commit real secrets.

# Base URL of the separately deployed shadercn-claims Worker.
# The same-origin /api/claims proxy forwards to this Worker.
CLAIMS_WORKER_URL="http://localhost:8787"

# Public Turnstile site key for the claim form (Cloudflare dashboard).
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
